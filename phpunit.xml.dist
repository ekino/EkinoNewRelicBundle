<?xml version="1.0" encoding="UTF-8"?>

<phpunit
        backupGlobals="false"
         colors="true"
         processIsolation="false"
         stopOnFailure="false"
         bootstrap="vendor/autoload.php"
>
    <testsuites>
        <testsuite name="Ekino New Relic Test Suite">
            <directory>./Tests</directory>
        </testsuite>
    </testsuites>

</phpunit>
